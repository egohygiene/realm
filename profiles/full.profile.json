{
  "schema_version": "1.0.0",
  "name": "full",
  "description": "Union of supported non-service development toolsets",
  "extends": ["rust", "node", "python"],
  "include": ["cloud-cli", "media-toolchain", "mantle-shell"],
  "exclude": [],
  "platforms": ["linux/amd64", "linux/arm64"],
  "projections": ["docker", "devcontainer", "nix", "workstation"],
  "constraints": {"allow_privileged": false, "allow_services": false, "secrets": "forbidden"}
}
