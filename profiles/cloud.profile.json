{
  "schema_version": "1.0.0",
  "name": "cloud",
  "description": "Base environment plus pinned infrastructure-as-code clients",
  "extends": ["base"],
  "include": ["cloud-cli"],
  "exclude": [],
  "platforms": ["linux/amd64", "linux/arm64"],
